#include <windows.h>
#include "version.h"

1 ICON "../src/Lyricod.App/Assets/Lyricod.ico"
1 RT_MANIFEST "launcher.manifest"

1 VERSIONINFO
FILEVERSION LYRICOD_VERSION
PRODUCTVERSION LYRICOD_VERSION
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE 0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", "Lyricod\0"
            VALUE "FileVersion", LYRICOD_VERSION_STRING "\0"
            VALUE "InternalName", "Lyricod\0"
            VALUE "OriginalFilename", "Lyricod.exe\0"
            VALUE "ProductName", "Lyricod\0"
            VALUE "ProductVersion", LYRICOD_VERSION_STRING "\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
