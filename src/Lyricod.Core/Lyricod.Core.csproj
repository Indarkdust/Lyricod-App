<Project Sdk="Microsoft.NET.Sdk">
  <!-- Everything that isn't Windows-specific: lyric sources, formats, matching,
       caching, romanisation. Builds and tests on any OS. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Lyricod.Core</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <!-- Pinyin and Traditional→Simplified Chinese (Apache-2.0). -->
    <PackageReference Include="ToolGood.Words" Version="3.1.0.3" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Lyricod.Core.Tests" />
  </ItemGroup>
</Project>
