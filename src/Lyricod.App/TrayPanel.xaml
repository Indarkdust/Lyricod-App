<?xml version="1.0" encoding="utf-8"?>
<!-- What the tray icon opens, laid out like the macOS app's menu-bar panel (and Windows' own quick
     settings): now playing, the desktop and island tiles, this song's lyrics and timing, and a
     footer. Opens above the notification area and closes when it loses focus. -->
<Window
    x:Class="Lyricod.TrayPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Lyricod">
    <Window.SystemBackdrop>
        <DesktopAcrylicBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="Root">
        <Grid.Resources>
            <!-- A rounded module, like Control Center's and quick settings'. -->
            <Style x:Key="Module" TargetType="Border">
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            </Style>
            <Style x:Key="Secondary" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                <Setter Property="TextWrapping" Value="NoWrap" />
            </Style>
            <Style x:Key="RowIcon" TargetType="Border">
                <Setter Property="Width" Value="32" />
                <Setter Property="Height" Value="32" />
                <Setter Property="CornerRadius" Value="16" />
                <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
            </Style>
        </Grid.Resources>

        <StackPanel x:Name="Panel" Padding="12" Spacing="8" Width="336" VerticalAlignment="Top">
            <!-- Now playing. -->
            <Border Style="{StaticResource Module}" Padding="14">
                <StackPanel Spacing="12">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="56" Height="56" CornerRadius="8" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                            <Grid>
                                <FontIcon Glyph="&#xE8D6;" FontSize="20" Opacity="0.5" />
                                <Image x:Name="Art" Stretch="UniformToFill" />
                            </Grid>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock x:Name="SongTitle" Style="{StaticResource BodyStrongTextBlockStyle}"
                                       TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                            <TextBlock x:Name="SongArtist" Style="{StaticResource Secondary}" FontSize="13" />
                        </StackPanel>
                    </Grid>
                    <Grid x:Name="ProgressHost" />
                    <StackPanel x:Name="TransportHost" HorizontalAlignment="Center" />
                </StackPanel>
            </Border>

            <!-- The two views, as quick-settings tiles. -->
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <ToggleButton x:Name="DesktopTile" HorizontalAlignment="Stretch" Height="72" Padding="12,8"
                              HorizontalContentAlignment="Left" Click="OnDesktopTile">
                    <StackPanel Spacing="6">
                        <FontIcon Glyph="&#xE7F4;" FontSize="16" HorizontalAlignment="Left" />
                        <TextBlock x:Name="DesktopTileText" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </ToggleButton>
                <ToggleButton x:Name="IslandTile" Grid.Column="1" HorizontalAlignment="Stretch" Height="72" Padding="12,8"
                              HorizontalContentAlignment="Left" Click="OnIslandTile">
                    <StackPanel Spacing="6">
                        <FontIcon Glyph="&#xE8D6;" FontSize="16" HorizontalAlignment="Left" />
                        <TextBlock x:Name="IslandTileText" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </ToggleButton>
            </Grid>

            <!-- This song: its lyrics (opens Choose Lyrics) and timing. -->
            <Border x:Name="ThisSong" Style="{StaticResource Module}">
                <StackPanel>
                    <Button x:Name="LyricsRow" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                            Background="Transparent" BorderThickness="0" Padding="10" CornerRadius="8,8,0,0" Click="OnLyricsRow">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource RowIcon}">
                                <FontIcon x:Name="LyricsIcon" Glyph="&#xE8BD;" FontSize="14" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                <TextBlock x:Name="LyricsTitle" Style="{StaticResource BodyStrongTextBlockStyle}" FontSize="13" />
                                <TextBlock x:Name="LyricsStatus" Style="{StaticResource Secondary}" />
                            </StackPanel>
                            <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="11" Opacity="0.5" VerticalAlignment="Center" />
                        </Grid>
                    </Button>
                    <Rectangle Height="1" Margin="52,0,0,0" Fill="{ThemeResource CardStrokeColorDefaultBrush}" />
                    <Grid Padding="10" ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource RowIcon}">
                            <FontIcon Glyph="&#xE916;" FontSize="14" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                            <TextBlock x:Name="TimingTitle" Style="{StaticResource BodyStrongTextBlockStyle}" FontSize="13" />
                            <TextBlock x:Name="TimingStatus" Style="{StaticResource Secondary}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <Button x:Name="LaterButton" Padding="9,7" Click="OnLater">
                                <FontIcon Glyph="&#xE738;" FontSize="11" />
                            </Button>
                            <Button x:Name="EarlierButton" Padding="9,7" Click="OnEarlier">
                                <FontIcon Glyph="&#xE710;" FontSize="11" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <HyperlinkButton x:Name="UpdateLink" Visibility="Collapsed" FontSize="12" Padding="2,0" />

            <!-- Footer. -->
            <Grid Margin="2,0">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <Button x:Name="LyricsWindowButton" Background="Transparent" BorderThickness="0" Padding="9,7" Click="OnLyricsWindow">
                        <FontIcon Glyph="&#xE8FD;" FontSize="15" />
                    </Button>
                    <Button x:Name="SettingsButton" Background="Transparent" BorderThickness="0" Padding="9,7" Click="OnSettings">
                        <FontIcon Glyph="&#xE713;" FontSize="15" />
                    </Button>
                </StackPanel>
                <Button x:Name="QuitButton" HorizontalAlignment="Right" Background="Transparent" BorderThickness="0" Padding="9,7" Click="OnQuit">
                    <FontIcon Glyph="&#xE7E8;" FontSize="15" />
                </Button>
            </Grid>
        </StackPanel>
    </Grid>
</Window>
