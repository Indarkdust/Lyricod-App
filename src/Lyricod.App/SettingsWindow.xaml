<?xml version="1.0" encoding="utf-8"?>
<!-- Lyricod's settings, laid out like Windows 11 Settings: panes on the left, cards on the right.
     The pages are built in code (SettingsWindow.xaml.cs) from the styles below. -->
<Window
    x:Class="Lyricod.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Lyricod">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="Root">
        <Grid.Resources>
            <!-- One setting: a rounded card, like Windows Settings. -->
            <Style x:Key="Card" TargetType="Border">
                <Setter Property="Padding" Value="16,12" />
                <Setter Property="MinHeight" Value="64" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Margin" Value="0,0,0,4" />
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            </Style>
            <Style x:Key="Heading" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
                <Setter Property="Margin" Value="1,24,0,8" />
            </Style>
            <Style x:Key="Detail" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <Style x:Key="Note" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Margin" Value="2,6,2,0" />
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- The title bar: drag area with the app's icon and name. -->
        <Grid x:Name="TitleBar" Padding="16,0,0,0">
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <Image x:Name="TitleIcon" Width="16" Height="16" />
                <TextBlock x:Name="TitleText" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <NavigationView x:Name="Nav" Grid.Row="1" PaneDisplayMode="Left" IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False" IsPaneToggleButtonVisible="False" OpenPaneLength="260"
                        SelectionChanged="OnPaneChanged">
            <ScrollViewer x:Name="Scroller">
                <StackPanel x:Name="Page" MaxWidth="1000" Padding="40,8,40,40" />
            </ScrollViewer>
        </NavigationView>
    </Grid>
</Window>
