<?xml version="1.0" encoding="utf-8"?>
<!-- The whole song over the album art. Narrow: lyrics with a control bar at the bottom. Wide or
     full screen: a large cover with the controls beside the lyrics, like the macOS app. -->
<Window
    x:Class="Lyricod.LyricsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Lyricod">

    <Grid x:Name="Root" RequestedTheme="Dark" Background="#141416">
        <!-- Background, as on the Mac: the softened cover slowly turning (ArtworkDrift), or the
             album's colour, under a shade so white text reads on any cover. -->
        <Grid x:Name="ArtHost" />
        <Rectangle x:Name="BackdropColour" Visibility="Collapsed" />
        <Rectangle x:Name="BackdropShade" Fill="#59000000" />

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="CoverColumn" Width="0" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Title bar: drag area; the buttons sit at its right, left of the caption buttons. -->
            <Grid x:Name="TitleBar" Grid.ColumnSpan="2" Background="Transparent" Margin="0,0,330,0" />
            <StackPanel x:Name="TopButtons" Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="4"
                        HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,4,148,0">
                <!-- On: bright; off: dimmed, as on the Mac. -->
                <Button x:Name="TranslationButton" Click="OnTranslation" Padding="8,5" Background="Transparent" BorderThickness="0">
                    <FontIcon Glyph="&#xF2B7;" FontSize="14" />
                </Button>
                <Button x:Name="PronunciationButton" Click="OnPronunciation" Padding="8,5" Background="Transparent" BorderThickness="0">
                    <TextBlock Text="Aa" FontSize="13" FontWeight="SemiBold" />
                </Button>
                <Button x:Name="ChooseButton" Click="OnChooseLyrics" Padding="8,5" Background="Transparent" BorderThickness="0">
                    <FontIcon Glyph="&#xE721;" FontSize="14" />
                </Button>
                <Button x:Name="FullScreenButton" Click="OnFullScreen" Padding="8,5" Background="Transparent" BorderThickness="0">
                    <FontIcon x:Name="FullScreenIcon" Glyph="&#xE740;" FontSize="14" />
                </Button>
            </StackPanel>

            <!-- Wide layout: a large cover, the song, progress and controls. -->
            <StackPanel x:Name="CoverPanel" Grid.Row="1" Grid.RowSpan="2" Grid.Column="0" VerticalAlignment="Center"
                        HorizontalAlignment="Center" Spacing="22" Visibility="Collapsed" Padding="24,0,24,40">
                <Border x:Name="BigCoverFrame" CornerRadius="14" Background="#30FFFFFF">
                    <Image x:Name="BigCover" Stretch="UniformToFill" />
                </Border>
                <StackPanel x:Name="BigTitles" Spacing="4" HorizontalAlignment="Center">
                    <TextBlock x:Name="BigTitle" FontSize="22" FontWeight="Bold" TextAlignment="Center"
                               TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="BigArtist" FontSize="16" Opacity="0.65" TextAlignment="Center" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <Grid x:Name="BigProgressHost" />
                <StackPanel x:Name="BigTransportHost" HorizontalAlignment="Center" />
            </StackPanel>

            <!-- The lyrics. -->
            <ScrollView x:Name="Scroller" Grid.Row="1" Grid.RowSpan="2" Grid.Column="1" ContentOrientation="Vertical"
                        VerticalScrollBarVisibility="Hidden" HorizontalScrollMode="Disabled"
                        ScrollAnimationStarting="OnScrollAnimationStarting">
                <StackPanel x:Name="Lines" />
            </ScrollView>
            <StackPanel x:Name="Message" Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center"
                        Spacing="12" Visibility="Collapsed">
                <TextBlock x:Name="MessageText" FontSize="20" FontWeight="SemiBold" Opacity="0.7" HorizontalAlignment="Center" TextAlignment="Center" />
                <TextBlock x:Name="MessageDetail" FontSize="13" Opacity="0.6" HorizontalAlignment="Center" TextAlignment="Center"
                           TextWrapping="Wrap" MaxWidth="320" Margin="0,-6,0,0" Visibility="Collapsed" />
                <Button x:Name="MessageButton" HorizontalAlignment="Center" Click="OnChooseLyrics" Visibility="Collapsed" />
            </StackPanel>

            <!-- Narrow layout: a floating bar with the song and controls. -->
            <Border x:Name="ControlBar" Grid.Row="2" Grid.Column="1" Margin="16" Padding="14,12" CornerRadius="16"
                    Background="#66000000" BorderBrush="#26FFFFFF" BorderThickness="1">
                <StackPanel Spacing="10">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border CornerRadius="8" Width="44" Height="44" Background="#30FFFFFF">
                            <Image x:Name="SmallCover" Stretch="UniformToFill" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                            <TextBlock x:Name="SmallTitle" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="SmallArtist" Opacity="0.65" FontSize="13" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <StackPanel x:Name="SmallTransportHost" Grid.Column="2" VerticalAlignment="Center" />
                    </Grid>
                    <Grid x:Name="SmallProgressHost" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Measures text in the lyric font. Invisible but laid out. -->
        <TextBlock x:Name="Measurer" Opacity="0" IsHitTestVisible="False" HorizontalAlignment="Left"
                   VerticalAlignment="Top" TextWrapping="NoWrap" />
    </Grid>
</Window>
